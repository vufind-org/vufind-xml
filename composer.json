{
    "name": "vufind-org/vufind-xml",
    "type": "library",
    "description": "Yet another XML parser, reader and writer for diverse records with and without namespaces.",
    "keywords": ["xml", "dom", "parser"],
    "license": "GPL-2.0-only",
    "version": "1.7.0",
    "autoload": {
        "psr-4": {
            "VuFindXml\\": "src/VuFindXml"
        }
    },
    "authors": [
        {
            "name": "Ere Maijala",
            "email": "ere.maijala@helsinki.fi"
        }
    ],
    "config": {
        "platform": {
            "php": "8.2"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.15",
        "guzzlehttp/guzzle": "7.14.2",
        "phing/phing": "3.1.2",
        "phpmd/phpmd": "2.15.0",
        "phpstan/phpstan": "2.2.5",
        "phpunit/php-code-coverage": "^11",
        "phpunit/phpunit": "11.5.56",
        "rector/rector": "2.5.7",
        "squizlabs/php_codesniffer": "4.0.1"
    },
    "scripts": {
        "fix": "phing fix-php",
        "qa": "phing qa-console"
    }
}

